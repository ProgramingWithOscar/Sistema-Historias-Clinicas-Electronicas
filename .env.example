# Copiar a .env  ->  cp .env.example .env
# Este archivo es la ÚNICA fuente de credenciales; compose.yaml no contiene secretos.
# .env está en .gitignore y en .dockerignore: nunca se commitea ni entra a las imágenes.

APP_NAME=HCE
APP_ENV=production
APP_DEBUG=false
# Generar con: docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8000

BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Credenciales MySQL ---
# MYSQL_* las consume la imagen de MySQL al inicializar el volumen.
# DB_* las consume Laravel. Deben coincidir entre sí.
MYSQL_DATABASE=hce
MYSQL_USER=hce
MYSQL_PASSWORD=cambiar_esta_clave
MYSQL_ROOT_PASSWORD=cambiar_esta_clave_root

DB_DATABASE=hce
DB_USERNAME=hce
DB_PASSWORD=cambiar_esta_clave

VITE_API_URL=http://localhost:8000/api

# Orígenes permitidos por CORS (separados por coma, sin espacios).
# Vite salta a 5174/5175 si el 5173 está ocupado por el contenedor frontend.
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Dominios que Sanctum trata como SPA de confianza (sesión por cookie).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:5175
# La cookie de sesión se comparte entre puertos del mismo host.
SESSION_DOMAIN=localhost
