# Copiar a .env  ->  cp .env.example .env
# Este archivo es la ÚNICA fuente de credenciales; compose.yaml no contiene secretos.
# .env está en .gitignore y en .dockerignore: nunca se commitea ni entra a las imágenes.

APP_NAME=HCE
APP_ENV=production
APP_DEBUG=false
# Generar con: docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8000

BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Credenciales MySQL ---
# MYSQL_* las consume la imagen de MySQL al inicializar el volumen.
# DB_* las consume Laravel. Deben coincidir entre sí.
MYSQL_DATABASE=hce
MYSQL_USER=hce
MYSQL_PASSWORD=cambiar_esta_clave
MYSQL_ROOT_PASSWORD=cambiar_esta_clave_root

DB_DATABASE=hce
DB_USERNAME=hce
DB_PASSWORD=cambiar_esta_clave

VITE_API_URL=http://localhost:8000/api
